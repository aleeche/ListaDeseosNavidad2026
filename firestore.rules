rules_version = '2';

// Reglas de seguridad de Firestore para la lista de deseos.
// Copia este archivo en Firebase Console → Firestore Database → Reglas → Publicar.
//
// El código familiar funciona como contraseña compartida: solo quien lo conoce
// puede leer o escribir las listas de esa familia. No existe ninguna regla que
// permita listar /familias, así que nadie puede descubrir los códigos de otras familias.
service cloud.firestore {
  match /databases/{database}/documents {
    match /familias/{codigo}/{coleccion}/{docId} {
      // Mismo formato que valida la app (js/util.js → codigoFamiliaValido).
      function codigoValido() {
        return codigo.matches('^[a-z0-9-]{12,64}$');
      }

      function coleccionValida() {
        return coleccion in ['miembros', 'deseos'];
      }

      function tamanoRazonable() {
        return request.resource.data.keys().size() <= 12;
      }

      allow read, delete: if codigoValido() && coleccionValida();
      allow create, update: if codigoValido() && coleccionValida() && tamanoRazonable();
    }
  }
}
